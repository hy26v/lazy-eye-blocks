<!doctype html>
<!-- ABOUTME: Shared shell for the game and its supporting pages. -->
<!-- ABOUTME: Provides common navigation, metadata, and site-wide styles. -->
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="keywords" content="lazy eye, amblyopia, visual exercise, blocks game">
        <meta name="description" content="A dichoptic blocks game with adjustable red and blue channels.">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="theme-color" content="#101216">
        <link rel="icon" href="icon.ico" type="image/x-icon">
        <link rel="stylesheet" href="css/main.css">

        <title>{{ title }}</title>

        {{#each links }}
            <link rel="{{ rel }}" href="{{ href }}">
        {{/each}}

        {{#each scripts }}
            <script src="{{ src }}"></script>
        {{/each}}

    </head>
    <body class="{{#if showNavigation}}site-body{{else}}exercise-body{{/if}}">
        <div class="site-shell">
            {{#if showNavigation}}
                <header class="site-header">
                    <a class="site-brand" href="index.html" aria-label="Lazy Eye Blocks home">
                        <span class="brand-mark" aria-hidden="true">
                            <span></span><span></span><span></span><span></span>
                        </span>
                        <span>Lazy Eye Blocks</span>
                    </a>
                    <nav class="site-nav" aria-label="Main navigation">
                        <a href="index.html" {{#if isHome}}aria-current="page"{{/if}}>Home</a>
                        <a href="exercise.html">Play</a>
                        <a href="help.html" {{#if isHelp}}aria-current="page"{{/if}}>Help</a>
                        <a href="about.html" {{#if isAbout}}aria-current="page"{{/if}}>About</a>
                    </nav>
                </header>
            {{/if}}

            {{{ body }}}

            {{#if showNavigation}}
                <footer class="site-footer">
                    <span>A blocks game built for both eyes.</span>
                    <a href="about.html#credits">Credits and license</a>
                </footer>
            {{/if}}
        </div>
    </body>
</html>
