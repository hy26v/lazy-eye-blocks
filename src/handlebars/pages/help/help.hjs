// ABOUTME: Builds the public help page from its content template.
// ABOUTME: Marks the active navigation page and supplies its title.
const { getCompiledTemplate, getRootTemplate } = require('../../handlebars-helper');

module.exports = () => {
    const root = getRootTemplate();
    const page = getCompiledTemplate(`${__dirname}/page.hbs`);

    const data = {
        title: 'Help',
        showNavigation: true,
        isHelp: true,
        body: page(),
    };

    return { code: root(data) };
};
