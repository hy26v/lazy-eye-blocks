// ABOUTME: Builds the full-screen game page and loads its runtime dependencies.
// ABOUTME: Supplies the game scripts and shared page shell data.
const { getCompiledTemplate, getRootTemplate } = require('../../handlebars-helper');

const scripts = [
    { src: 'js/main.js' },
    { src: 'https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js' },
];

module.exports = () => {
    const root = getRootTemplate();
    const page = getCompiledTemplate(`${__dirname}/page.hbs`);
    const data = {
        scripts,
        title: 'Exercise',
        showNavigation: false,
        body: page(),
    };
    return { code: root(data) };
};
