// ABOUTME: Builds the public about and attribution page.
// ABOUTME: Supplies the current page state and its content template.
const { getCompiledTemplate, getRootTemplate } = require('../../handlebars-helper');

module.exports = () => {
    const root = getRootTemplate();
    const page = getCompiledTemplate(`${__dirname}/page.hbs`);

    const data = {
        title: 'About Lazy Eye Blocks',
        showNavigation: true,
        isAbout: true,
        body: page(),
    };

    return { code: root(data) };
};
